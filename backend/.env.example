# ==============================================================================
# Misconception Mapper (MM) - Backend Environment Configuration Template
# ==============================================================================

ENVIRONMENT=development
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DEBUG=True

# Database Configuration
DATABASE_URL=sqlite:///./misconception_mapper.db

# LLM Provider Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# CORS & Frontend Origins
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# RAG & Vector Database Configuration
CHROMA_PATH=./rag/storage/chroma_db
RAG_UPLOAD_DIR=./rag/storage/uploads

