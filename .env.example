# ==============================================================================
# Misconception Mapper (MM) - Environment Configuration Template
# Copy this file to .env and provide your actual API keys. Never commit real keys.
# ==============================================================================

# Backend Server Configuration
ENVIRONMENT=development
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DEBUG=True

# Database Configuration
DATABASE_URL=sqlite:///./misconception_mapper.db

# LLM Providers
# Primary LLM Provider: Groq (Llama-3.3-70b-versatile or similar)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Fallback LLM Provider: Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# CORS & Frontend Origins
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# Optional RAG Configuration (Phase P3)
CHROMA_PERSIST_DIRECTORY=./rag/chroma_db
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
